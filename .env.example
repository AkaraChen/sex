# HTTP
SEX_HOST=127.0.0.1
SEX_PORT=3002

# firecrawl-local: a managed child process by default. Without one on PATH, give its path.
# SEX_LOCAL_PATH=/usr/local/bin/firecrawl-local
# Use a running instance instead:
# SEX_LOCAL_URL=http://127.0.0.1:3003
# SEX_LOCAL_TOKEN=

# Chrome for pages that need JavaScript. firecrawl-local finds one itself; override with:
# SEX_CHROME_PATH=/usr/bin/google-chrome
# SEX_BROWSER=auto   # auto | never | always

# SearXNG: a managed child process by default, started from @searxng-js/searxng.
# SEX_SEARXNG_URL=http://127.0.0.1:8888
# SEX_SEARXNG_PATH=/usr/local/bin/searxng

# Private networks are refused unless this is 1 (cloud metadata addresses stay refused).
# SEX_ALLOW_PRIVATE=1

# SEX_LOG_LEVEL=info   # debug | info | warn | error
