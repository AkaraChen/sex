# Copy to .env and uncomment what you need. docker compose reads this file for the LLM, docs and SearXNG settings.
# An empty value counts as unset.

# LLM features (json/summary formats, /v2/extract, crawl prompts) stay off until a model is set.
# SEX_LLM_MODEL=gpt-4o-mini
# SEX_LLM_API_KEY=
# SEX_LLM_BASE_URL=https://api.openai.com/v1
# A cheaper model for the guard, extract planning, schema and crawl prompt calls; same endpoint and key. Unset: the main model.
# SEX_LLM_SMALL_MODEL=gpt-4o-mini

# PDFs, office documents and images through here-docs (structure + local OCR). CPU-heavy, so off by default.
# SEX_DOCS=1

# sex runs SearXNG itself by default. Point it at an already deployed instance instead (json format enabled):
# SEX_SEARXNG_URL=http://searxng.internal:8080

# Browser origins allowed to call the HTTP API and MCP endpoint cross-origin (comma-separated). Empty disables CORS.
# Compose only forwards the variables listed in compose.yaml, so add this one to its environment block for docker use.
# SEX_CORS_ORIGINS=

# Host header hostnames accepted by the HTTP API and MCP endpoint (comma-separated, no port).
# SEX_ALLOWED_HOSTS=
