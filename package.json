{
  "name": "sex-workspace",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "bun apps/sex/src/cli.ts serve",
    "test": "bun test ./packages ./apps",
    "check": "tsc --noEmit",
    "build": "bun apps/sex/scripts/build.ts",
    "format": "biome check --write packages apps",
    "lint": "biome check packages apps"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.5",
    "typescript": "^7.0.2"
  }
}
