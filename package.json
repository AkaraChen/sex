{
  "name": "sex-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun packages/sex/src/cli.ts",
    "dev:lite": "bun packages/sex-lite/src/cli.ts",
    "typecheck": "bun check",
    "lint": "biome check packages",
    "format": "biome check --write packages",
    "test": "bun test",
    "verify": "bun check && bun run lint && bun test",
    "build": "bun packages/sex/scripts/build.ts",
    "build:lite": "bun packages/sex-lite/scripts/build.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@mendable/firecrawl-js": "^4.51.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/bun": "^1.4.4"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
