{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["packages/*/src/**", "packages/*/test/**", "packages/*/scripts/**", "apps/*/src/**", "apps/*/test/**", "apps/*/scripts/**", "scripts/**", "e2e/**"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "linter": { "rules": { "preset": "recommended", "style":{ "noNonNullAssertion": "off" }, "suspicious": { "noExplicitAny": "off" } } }
}
